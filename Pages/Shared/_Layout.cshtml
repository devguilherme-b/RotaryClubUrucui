<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rotary Club de Uruçuí</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Main Page Style-->
    <link rel="stylesheet" href="~/css/Index/Home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Index/About.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Index/Projects.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Index/Blog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Index/Agenda.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Index/Partners.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Index/Contribute.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Index/Contacts.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/FidOutMore/FindOutMore.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/BoardOfDirectors/BoardOfDirectors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RotaryClubUrucui.styles.css" asp-append-version="true" />
    <!-- External links-->  
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@100..800&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />

</head>
<body>
    <header>
        <h6 data-aos="fade-up" class="rotary-year">ANO ROTÁRIO 2025 - 2026 - URUÇUÍ</h6>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand text-light" asp-area="" asp-page="/Index" asp-fragment="inicio">
                    <img src="~/Media/Imgs/WHITE-LOGO-ROTARY-CLUB-URUÇUÍ.png" alt="Logo da Rotary Club de Uruçuí." height="50" asp-append-version="true"/>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="50" height="50" viewBox="0,0,256,256">
                        <g fill="#ffffff" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-size="none" style="mix-blend-mode: normal"><g transform="scale(3.55556,3.55556)"><path d="M56,48c2.209,0 4,1.791 4,4c0,2.209 -1.791,4 -4,4c-1.202,0 -38.798,0 -40,0c-2.209,0 -4,-1.791 -4,-4c0,-2.209 1.791,-4 4,-4c1.202,0 38.798,0 40,0zM56,32c2.209,0 4,1.791 4,4c0,2.209 -1.791,4 -4,4c-1.202,0 -38.798,0 -40,0c-2.209,0 -4,-1.791 -4,-4c0,-2.209 1.791,-4 4,-4c1.202,0 38.798,0 40,0zM56,16c2.209,0 4,1.791 4,4c0,2.209 -1.791,4 -4,4c-1.202,0 -38.798,0 -40,0c-2.209,0 -4,-1.791 -4,-4c0,-2.209 1.791,-4 4,-4c1.202,0 38.798,0 40,0z"></path></g></g>
                    </svg>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1 justify-content-center">
                        <li class="nav-item-edited">
                            <a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="inicio">Início</a>
                        </li>
                        <li class="nav-item dropdown ">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Sobre</a>
                            <ul class="dropdown-menu">
                                <li class="nav-item-edited"><a class="nav-link text-light" asp-area="" asp-page="/FindOutMore" asp-fragment="quem-somos">Quem somos</a></li>
                                <li class="nav-item-edited"><a class="nav-link text-light" asp-area="" asp-page="/BoardOfDirectors" asp-fragment="diretoria">Diretoria</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Ações</a>
                            <ul class="dropdown-menu">
                                <li class="nav-item-edited"><a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="projetos">Projetos</a></li>
                                <li class="nav-item-edited"><a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="blog">Notícias</a></li>
                                <li class="nav-item-edited"><a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="agenda">Agenda</a></li>
                            </ul>
                        </li>
                        <li class="nav-item-edited">
                            <a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="parceiros">Parceiros</a>
                        </li>
                        <li class="nav-item-edited">
                            <a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="doe-agora">Doe Agora</a>
                        </li>
                        <li class="nav-item-edited">
                            <a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="contatos">Contatos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container-edited">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            <div class="footer-as-secondary-menu">
                <div class="footer-logo d-flex justify-content-center text-center">
                    <img src="~/Media/Imgs/WHITE-LOGO-ROTARY-CLUB-URUÇUÍ.png" alt="Logo da Rotary Club de Uruçuí." height="90" asp-append-version="true" />
                </div>
                <nav data-aos="fade-up" class="nav-footer">
                    <div class="nav-footer-item">
                        <p class="nav-link">Sobre</p>
                        <ul>
                            <li>
                                <a class="nav-link text-light" asp-page="/About" asp-fragment="quem-somos">Quem Somos</a>
                            </li>
                            <li>
                                <a class="nav-link text-light" asp-area="" asp-page="/Board" asp-fragment="diretoria">Diretoria</a>
                            </li>
                        </ul>
                    </div>
                    <div class="nav-footer-item">
                        <p class="nav-link">Ações</p>
                        <ul>
                            <li>
                                <a class="nav-link text-light" asp-page="/Index" asp-fragment="projetos">Projetos</a>
                            </li>
                            <li>
                                <a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="blog">Notícias</a>
                            </li>
                            <li>
                                <a class="nav-link text-light" asp-area="" asp-page="/Index" asp-fragment="agenda">Agenda</a>
                            </li>
                        </ul>
                    </div>
                    <div class="nav-footer-item">
                        <p class="nav-link">Redes de contato</p>
                        <ul>
                            <li>
                                <a class="nav-link text-light" href="https://www.instagram.com/rotaryclubdeurucui">Instagram</a>
                            </li>
                            <li>
                                <a class="nav-link text-light" href="mailto:igordemonteiro19@gmail.com?subject=Proposta%20de%20Parceria%20%E2%80%93%20Via%20site%20do%20Rotary%20Club%20de%20Uru%C3%A7u%C3%AD&body=Ol%C3%A1%2C%20Rotary%20Club%20de%20Uru%C3%A7u%C3%AD!%0D%0A%0D%0AEntrei%20em%20contato%20atrav%C3%A9s%20do%20site%20porque%20tenho%20interesse%20em%20propor%20uma%20parceria.%0D%0A%0D%0ASegue%20abaixo%20um%20breve%20resumo%20da%20proposta%3A%0D%0A%0D%0ANome%3A%0D%0AOrganiza%C3%A7%C3%A3o%20%2F%20Empresa%3A%0D%0ATipo%20de%20parceria%20desejada%3A%0D%0ADescri%C3%A7%C3%A3o%20da%20proposta%3A%0D%0A%0D%0AFico%20%C3%A0%20disposi%C3%A7%C3%A3o%20para%20conversarmos%20melhor.%0D%0A%0D%0AAtenciosamente%2C%0D%0A%5BSeu%20Nome%5D%0D%0A%5BTelefone%20%2F%20E-mail%20para%20contato%5D">E-mail</a>
                            </li>
                        </ul>
                    </div>
                    <div class="nav-footer-item">
                        <p class="nav-link">Rotary Internacional</p>
                        <ul>
                            <li>
                                <a class="nav-link text-light" href="https://www.rotary.org">rotary.org</a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
            <div class="credits-for-developer" align="right">
                Desenvolvido por <a href="https://devguilherme.onrender.com/">DEVguilherme</a>
            </div>
            <p> &copy; 2025 - Rotary Club de Urucui. Todos os direitos reservados.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
        AOS.init();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>