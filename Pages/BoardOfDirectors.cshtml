@page "/diretoria"
@model RotaryClubUrucui.Pages.BoardOfDirectorsModel
@{
    ViewData["Title"] = "Diretotia"; 
}

<img data-aos="fade-up" id="diretoria" class="find-out-more-img-top" src="~/Media/Imgs/FIND-OUT-MORE-BACKGROUND.jpg" alt="Imagem de fundo para a página de saiba mais" />
<div class="board-of-directors">
    <div class="board-of-directors-content">
        <h1 data-aos="fade-up">Diretoria 2025/2026 - Rotary Club de Uruçuí</h1>
        <p data-aos="fade-up">O Rotary Club de Uruçuí é conduzido por líderes voluntários comprometidos em servir à comunidade com ética, responsabilidade e dedicação.</p>
        <p data-aos="fade-up">Cada membro da diretoria coloca seu talento a serviço de um propósito maior: <span class="span-green">transformar vidas e fortalecer laços de amizade e solidariedade</span></p>
        <h1 data-aos="fade-up">Nossa estrutura</h1>
        <h1 data-aos="fade-up" class="board-director">Conselho Diretor</h1>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/LUCILENE.jpg" alt="Presidente do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/LUCILENE.jpg" alt="Presidente do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Lucilene Pereira de Sousa Moraes</h5>
                        <h6 class="board-director-position">Presidenta</h6>
                    </div>
                </div>
                <p class="member-description">
                    Os <span class="span-dark-blue">presidentes</span> de clube planejam e lideram reuniões, estabelecem metas,
                    incentivam a comunicação entre comissões e distritos, analisam as despesas,
                    participam das decisões e motivam os associados. Eles também colaboram com
                    o governador de distrito e o governador assistente.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/ERIVAN.jpg" alt="Vice-presidente do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/ERIVAN.jpg" alt="Vice-presidente do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Erivan Barbosa Pires</h5>
                        <h6 class="board-director-position">Vice-presidente</h6>
                    </div>
                </div>
                <p class="member-description">
                    O <span class="span-dark-blue">Vice-presidente</span> do Rotary Clube desempenha um
                    papel crucial, especialmente na ausência do Presidente, liderando as
                    reuniões de clube e do Conselho Diretor. Além disso, pode auxiliar na
                    condução de Assembleia de Clube e contribuir para o planejamento e
                    execução de projetos e atividades
                    do clube.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/LYDYANE.jpg" alt="Secretaria Executiva do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/LYDYANE.jpg" alt="Secretaria Executiva do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Lydyane de Oliveira Chaves Lima</h5>
                        <h6 class="board-director-position">Secretaria Executiva</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-dark-blue">Secretaria Executiva</span> do  clube do Rotary desempenha um
                    papel crucial na gestão e funcionamento do clube, sendo um apoio
                    fundamental para o Conselho Diretor e demais membros. Ela é
                    responsável por diversas tarefas, incluindo a organização de reuniões,
                    gestão de documentos, comunicação interna e externa, e organização
                    da agenda do clube. Ela é um elo entre o Conselho Diretor, os
                    membros e o Rotary International
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/CLELIA.png" alt="Tesoureira do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/CLELIA.png" alt="Tesoureira do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Clélia da Silva Marisco</h5>
                        <h6 class="board-director-position">Tesoureira</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-dark-blue">Tesoureira</span> do Rotary Club é responsável por gerir as
                    finanças do clube, garantindo que as contas sejam mantidas em
                    ordem e que os fundos sejam usados de forma responsável. Eles
                    também supervisionam as contas do clube e as doações à Fundação
                    Rotária.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/ANA ROSA.jpg" alt="Diretora de Protocolo do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/ANA ROSA.jpg" alt="Diretora de Protocolo do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Ana Rosa da Silva Lima Pereira</h5>
                        <h6 class="board-director-position">Diretora de Protocolo</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-dark-blue">Diretora de Protocolo</span> do Rotary Club tem como função cuidar do
                    aspecto prático e das facilidades físicas de cada reunião, bem como
                    orientar discretamente seu desenrolar. Da eficiência do Diretor de
                    Protocolo dependem a ordem e o sucesso da reunião.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/MÁRIO-SÉRGIO.jpg" alt="Facilitador do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/MÁRIO-SÉRGIO.jpg" alt="Facilitador de Protocolo do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Mário Sérgio Cruz Sá</h5>
                        <h6 class="board-director-position">Facilitador</h6>
                    </div>
                </div>
                <p class="member-description">
                    O <span class="span-dark-blue">Facilitador</span> do Rotary Clube ajuda a desenvolver e a
                    implementar programas de aprendizagem para os associados do
                    clube. Eles trabalham com os lideres do clube para criar eventos de
                    aprendizagem que atendem às necessidades dos associados.
                </p>
            </div>
        </div>

        <h1 data-aos="fade-up" class="commissions">Comissões</h1>
        
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/ALAIANE.jpg" alt="Presidente da Comissão de Administração do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/ALAIANE.jpg" alt="Presidente da Comissão de Administração de Protocolo do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Alaiane Rodrigues ruz Sá</h5>
                        <h6 class="commissions-position">Presidente da Comissão de Administração</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-green">Presidente da Comissão de Administração</span> do Rotary Clube é
                    responsável por supervisionar o gerenciamento do clube, e organizar e coordenar as tarefas abaixo:
                </p>
                <ul>
                    <li>Ajudar o secretário do clube com a logística das reuniões;</li>
                    <li>Organizar reuniões interessantes e divertidas para os associados;</li>
                    <li>Planejar eventos sociais para os associados.</li>
                </ul>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/MÁRIO-SÉRGIO.jpg" alt="Presidente da Comissão de Desenvolvimento do Quadro Associativo - D.Q.A do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/MÁRIO-SÉRGIO.jpg" alt="Presidente da Comissão de Desenvolvimento do Quadro Associativo - D.Q.A de Protocolo do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Mário Sérgio Cruz Sá</h5>
                        <h6 class="commissions-position">Presidente da Comissão de D.Q.A</h6>
                    </div>
                </div>
                <p class="member-description">
                    O <span class="span-green">Presidente da Comissão de Desenvolvimento do Quadro Associativo - D.Q.A</span> do Rotary Clube é 
                    responsável pela implementação do plano para aumento do número de associados, que deve
                    abordar os pontos fortes e os desafios únicos do seu clube, trabalhar no recrutamento, retenção e
                    orientação de rotarianos.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/IRENICE.jpg" alt="Presidente da Comissão da Fundação Rotária do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/IRENICE.jpg" alt="Presidente da Comissão da Fundação Rotária do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Irenice Sarairva de Andradde Moreira</h5>
                        <h6 class="commissions-position">Presidente da Comissão da Fundação Rotária</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-green">Presidente da Comissão da Fundação Rotária</span> do Rotary Clube é
                    responsável por estabelecer e executar as metas da Fundação Rotária de acordo com as diretrizes do clube.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/KATHYWCE.jpg" alt="Presidente da Comissão de Imagem Pública do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/KATHYWCE.jpg" alt="Presidente da Comissão de Imagem Pública do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Kathywce de Almeida Cardoso Sousa</h5>
                        <h6 class="commissions-position">Presidente da Comissão de Imagem Pública</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-green">Presidente da Comissão de Imagem Pública</span> do Rotary Clube deve 
                    criar e executar um plano para divulgar ao público as atividades e projetos do clube e
                    informações sobre o Rotary International.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/DARLEY.jpg" alt="Presidente da Comissão de Projetos Humanitários do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/DARLEY.jpg" alt="Presidente da Comissão de Projetos Humanitários do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Darley Sousa de Oliveira</h5>
                        <h6 class="commissions-position">Presidente da Comissão de Projetos Humanitários</h6>
                    </div>
                </div>
                <p class="member-description">
                    O <span class="span-green">Presidente da Comissão de Projetos Humanitários</span> do Rotary Clube tem como 
                    função liderar as ações sociais do clube, assegurando que atendam às necessidades locais. Os membros devem
                    conhecer e estar envolvidos na comunidade.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/GIRLE.jpg" alt="Presidente da Comissão de Serviços às Novas Gerações do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/GIRLE.jpg" alt="Presidente da Comissão de Serviços às Novas Gerações do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Girle dos Santos Lacerda</h5>
                        <h6 class="commissions-position">Presidente da Comissão de Serviços às Novas Gerações</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-green">Presidente da Comissão de Serviços às Novas Gerações</span> do Rotary Clube tem como
                    função desenvolver atividades com objetivo de melhorar a capacitação profissional dos jovens e usar todos os
                    programas destinados às novas gerações.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/NILZA.jpg" alt="Presidente da Comissão de Diversidade, Equidade e Inclusão do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/NILZA.jpg" alt="Presidente da Comissão de Diversidade, Equidade e Inclusão do Rotary Club de Uruçuí" />
                    <div>
                        <h5>Nilza Machado Beeker</h5>
                        <h6 class="commissions-position">Presidente da Comissão de Diversidade, Equidade e Inclusão</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-green">Presidente da Comissão de Diversidade, Equidade e Inclusão</span> do Rotary Clube tem como
                    função liderar e coordenar esforços com a comissão, visando promover a inclusão e o respeito à diversidade
                    dentro do Rotary Club. Esta função envolve a criação de políticas e programas que garantam que todos
                    os membros se sintam valorizados e inclusos, independentemente de suas características pessoais.
                </p>
            </div>
        </div>
        <div data-aos="fade-up" class="rotary-member">
            <img class="element-for-tablet-and-desktop" src="~/Media/Imgs/BoardOfDirectors/RAIMUNDA.jpg" alt=" Presidente da Comissão de Companherismo do Rotary Club de Uruçuí" />
            <div class="rotary-member-content">
                <div class="member-header">
                    <img class="element-for-mobile" src="~/Media/Imgs/BoardOfDirectors/RAIMUNDA.jpg" alt=" Presidente da Comissão de Companherismo do Rotary Club de Uruçuí"/>
                    <div>
                        <h5>Raimunda Araújo da Costa Cardoso</h5>
                        <h6 class="commissions-position"> Presidente da Comissão de Companherismo</h6>
                    </div>
                </div>
                <p class="member-description">
                    A <span class="span-green"> Presidente da Comissão de Companherismo</span> do Rotary Clube tem como
                    função fFortalecer os laços entre os membros do Rotary e promover a amizade, tanto dentro dos clubes quanto
                    em nível internacional. Ela oferece oportunidades para que rotarianos e seus familiares se conectem
                    através de interesses e atividades em comum, criando um ambiente acolhedor e inclusivo.
                </p>
            </div>
        </div>
    </div>
</div>