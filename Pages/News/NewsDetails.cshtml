@page "/noticias/{id:int}"
@model RotaryClubUrucui.Pages.News.NewsDetailsModel
@{
    ViewData["Title"] = "Detalhes da Notícia";
}

@if (Model.Noticia != null)
{
    <img class="news-details-img" src="@Model.Noticia.ImageUrl" alt="@Model.Noticia.Title" />
    <div class="news-details-container">
        <div class="news-details">
            <h1 class="news-details-title">@Model.Noticia.Title</h1>
            <p>@Model.Noticia.Subtitle</p>
            @for (int i = 0; i < @Model.Noticia.Paragraphs.Count(); i++)
            {
                <p>@Model.Noticia.Paragraphs[i]</p>
            }
            <img class="news-details-img-text" src="@Model.Noticia.ImageUrl" alt="@Model.Noticia.Title" />
        </div>
    </div>
}
else
{
    <p>Notícia não encontrada.</p>
}