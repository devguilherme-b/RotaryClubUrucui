@page "/agenda"
@model RotaryClubUrucui.Pages.AgendaModel
@{
    ViewData["Title"] = "Agenda do Rotary";
}

<div class="agenda-container">
    <img data-aos="fade-up" class="find-out-more-img-top" src="~/Media/Imgs/FIND-OUT-MORE-BACKGROUND.jpg" alt="Imagem de fundo para a página de saiba mais" />      
    <div class="section-topic">
        <img src="~/Media/Imgs/ROTARY-RODA-DE-TREM.png" alt="Imagem da endrenagem da logo do rotary club" />
        <h1>AGENDA 2025</h1>
    </div>
    <div id="agenda-first-year">
        <details class="agenda-month">
            <summary>JULHO</summary>
            <ul class="agenda-month-content">
                <li>
                    Festiva de Posse Reunião com Conselho Diretor
                    Planejamento de ações;
                </li>
                <li>
                    Divulgação nas redes sociais do novo Conselho
                    Diretor; Lançamento da campanha “Rotary é
                    Servir”.
                </li>
            </ul>
        </details>    
        <details class="agenda-month">
            <summary>AGOSTO</summary>
            <ul class="agenda-month-content">
                <li>
                    Capacitação e Estratégias de crescimento - The
                    World Café – Metodologia Ativa;
                </li>
                <li>
                    Reunião com Prefeito - Rotary entidade pública;
                    Marco Rotário;
                </li>
                <li>
                    Reunião com Secretária de Meio Ambiente
                    Planejar ações para Mutirão Ecológico: Campanha
                    “Adote uma Praça” para revitalizar e cuidar de
                    espaços públicos.
                </li>
            </ul>
        </details>
        <details class="agenda-month">
            <summary>SETEMBRO</summary>
            <ul class="agenda-month-content">
                <li>
                    Piquenique com familiares (Companheirismo ao ar livre);
                </li>
                <li>
                    “Rotary pela Cidadania” Participação viva do Rotary na
                    comemoração de aniversário de Uruçuí e do mês cívico;
                    Sugerir Momento Cívico; Reunião com Secretaria de
                    Educação.
                </li>
            </ul>
        </details>
        <details class="agenda-month">
            <summary>OUTUBRO</summary>
            <ul class="agenda-month-content">
                <li>
                    Noite – “Karaokê do Rotary” (Arrecadar fundo) ·Uma
                    noite para cantar, sorri e celebrar o
                    companheirismo como só o Rotary sabe fazer!
                </li>
                <li>
                    Dia das Crianças: arrecadação de brinquedos entre
                    sócios; Ação em creche ou bairro: brinquedos,
                    lanche, brincadeiras com voluntários.
                </li>
            </ul>
        </details>
        <details class="agenda-month november-month">
            <summary>NOVEMBRO</summary>
            <ul class="agenda-month-content">
                <li>
                    BINGO DO ROTARY – “Rodadas do Bem” Evento simples, lucrativo e de forte apelo 
                    popular, para todo público;
                </li>
                <li>
                    Campanha “Saúde do Homem”: parceria com Secretaria Municipal de Saúde e Programa 
                    do SENAR para exames básicos; 
                </li>
            </ul>
        </details>
        <details class="agenda-month december-month">
            <summary>DEZEMBRO</summary>
            <ul class="agenda-month-content">
                <li>
                    Confraternização de Fim de Ano com trocas
                    simbólicas de presentes - Reconhecimento: sócio
                    destaque do semestre;
                </li>
                <li>
                     “Natal com Afeto” – Visitas Humanizadas-Rotary 
                     visita: Idosos; Hospital; APAE: Levar palavras de/ 
                     carinho, apresentações musicais, teatro, violão, 
                     cartinhas, coral ou poesias. Entregar lembrancinhas 
                     simbólicas: cartões feitos por crianças, kits de 
                     higiene, panetones (algo acessível).
                </li>
                <li>
                    “Rotary Ilumina a Cidade” – Decoração de Espaço
                    Público; Decorar uma praça, poste, canteiro ou
                    escola com luzes, cartazes ou mensagens positivas.
                    Instalação de uma mensagem do Rotary com o
                    lema “Unidos para fazer o bem”.
                </li>
                <li>
                    “Cartinhas do Bem” – Apadrinhamento de Sonhos
                    Criar parceria com uma escola pública onde as
                    crianças escrevem cartinhas com desejos
                    simbólicos (não brinquedos caros); Rotarianos,
                    empresas ou voluntários apadrinham com
                    presentes simples ou experiências;
                </li>
            </ul>
        </details>
    </div>

    <div class="section-topic">
        <img src="~/Media/Imgs/ROTARY-RODA-DE-TREM.png" alt="Imagem da endrenagem da logo do rotary club" />
        <h1>AGENDA 2026</h1>
    </div>
    <div id="agenda-second-year">
        <details class="agenda-month">
            <summary>JANEIRO</summary>
            <ul class="agenda-month-content">
                <li>
                    Feijoada do Rotary – Arrecadar fundos; Oficina
                    interna de planejamento: revisar metas com todos os
                    sócios.
                </li>
                <li>
                    Divulgação nas redes: retrospectiva do semestre com
                    fotos e resultados Participação ‘VIVA” do Rotary nos
                    Festejos de São Sebastião.
                </li>
            </ul>
        </details> 
        <details class="agenda-month">
            <summary>FEVEREIRO</summary>
            <ul class="agenda-month-content">
                <li>
                    Rotary em Movimento: União que Transforma: Rotary de
                    Uruçuí visita o Rotary de Guadalupe;
                </li>
                <li>
                    Bazar do Bem Roupas, calçados, brinquedos, acessórios,
                    utensílios domésticos. Preferência itens em bom estado.
                </li>
            </ul>
        </details>
        <details class="agenda-month march-month">
            <summary>MARÇO</summary>
            <ul class="agenda-month-content">
                <li>
                    Rotary Plural: Fortalecendo o Futuro com Diversidade
                    Mostrar que o Rotary é um espaço inclusivo e moderno;
                    Ampliar o impacto social do clube com a diversidade de
                    ideias e experiências. Fazer um levantamento interno dos
                    atuais associados (gênero, faixa etária, profissão);
                    Identificar lacunas (ex: poucas mulheres, jovens ou
                    profissionais de saúde, educação, etc.). Campanha:
                    “Rotary é para todos. E para você também!” Criar artes
                    para redes sociais destacando: Diversidade dos membros;
                    Depoimentos de associados de diferentes perfis; Usar
                    linguagem acolhedora e inclusiva.
                </li>
            </ul>
        </details>
        <details class="agenda-month">
            <summary>ABRIL</summary>
            <ul class="agenda-month-content">
                <li>
                    Gincana Solidária: Dividir os sócios em equipes para
                    disputar quem arrecada mais mantimentos, fraldas,
                    kit higiene.
                </li>
            </ul>
        </details>
        <details class="agenda-month">
            <summary>MAIO</summary>
            <ul class="agenda-month-content">
                <li>
                    Roda de Talentos I- Início da transição de gestão:
                    escuta ativa dos sócios;
                </li>
                <li>
                    Campanha “Saúde da Família”: feira de serviços 
                    com parceiros da saúde local.
                </li>
            </ul>
        </details>
        <details class="agenda-month june-month">
            <summary>JUNHO</summary>
            <ul class="agenda-month-content">
                <li>
                    Assembleia de avaliação da gestão- Encerramento
                    da gestão.
                </li>
                <li>
                    Arraia do Rotary” – Festa Junina Divulgação dos
                    resultados da gestão: postagens com dados e
                    depoimentos da comunidade.
                </li>
            </ul>
        </details>
    </div>
    <a data-aos="fade-up" class="btn-responsive-contribute" asp-page="/Index" asp-fragment="doe-agora">QUERO CONTRIBUIR</a>
</div>